@model List<IMS.Web.Models.User>
@using IMS.Web.Enums
@{ ViewData["Title"] = "Manage Users"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 style="font-size:1.15rem;font-weight:700;color:var(--text);margin:0 0 4px">Manage Users</h4>
        <p style="color:var(--text-muted);font-size:.83rem;margin:0">@Model.Count user(s) shown</p>
    </div>
    <a asp-action="CreateUser" class="btn-ims btn-ims-danger"><i class="bi bi-person-plus me-1"></i>Add User</a>
</div>

<div class="d-flex gap-2 mb-4 flex-wrap">
    <a class="btn-ims @(ViewBag.CurrentRole == null ? "btn-ims-primary" : "btn-ims-outline")" style="font-size:.82rem;padding:6px 12px" asp-action="Users">All</a>
    @foreach (var role in Enum.GetValues<Role>())
    {
        <a class="btn-ims @(ViewBag.CurrentRole == role.ToString() ? "btn-ims-primary" : "btn-ims-outline")" style="font-size:.82rem;padding:6px 12px"
           asp-action="Users" asp-route-role="@role">@role</a>
    }
</div>

<div class="ims-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Registered</th>
                    <th>Change Role</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" style="text-align:center;padding:40px;color:var(--text-muted)">
                        <i class="bi bi-people" style="font-size:2rem;display:block;margin-bottom:8px;opacity:.3"></i>
                        No users found.
                    </td>
                </tr>
            }
            @foreach (var user in Model)
            {
                <tr>
                    <td style="font-size:.78rem;color:var(--text-muted)">@user.Id</td>
                    <td style="font-weight:600">@user.FullName</td>
                    <td style="color:var(--text-muted)">@user.Email</td>
                    <td>
                        <span class="badge @(user.Role == Role.Admin ? "bg-danger" :
                                             user.Role == Role.Coordinator ? "bg-warning text-dark" :
                                             user.Role == Role.Supervisor ? "bg-success" : "bg-primary")">
                            @user.Role
                        </span>
                    </td>
                    <td style="font-size:.8rem;color:var(--text-muted)">@user.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                    <td>
                        <form asp-action="ChangeRole" method="post" class="d-flex gap-1">
                            <input type="hidden" name="id" value="@user.Id" />
                            <select name="newRole" class="form-select form-select-sm" style="width:130px">
                                @foreach (var r in Enum.GetValues<Role>())
                                {
                                    if (user.Role == r)
                                    {
                                        <option value="@((int)r)" selected="selected">@r</option>
                                    }
                                    else
                                    {
                                        <option value="@((int)r)">@r</option>
                                    }
                                }
                            </select>
                            <button type="submit" class="btn-ims btn-ims-outline" style="padding:5px 8px" title="Apply">
                                <i class="bi bi-check2"></i>
                            </button>
                        </form>
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <a asp-action="EditUser" asp-route-id="@user.Id"
                               class="btn-ims btn-ims-outline" style="padding:5px 9px" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="DeleteUser" method="post"
                                  onsubmit="return confirm('Delete @user.FullName? This cannot be undone.')">
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="btn-ims btn-ims-danger" style="padding:5px 9px" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
