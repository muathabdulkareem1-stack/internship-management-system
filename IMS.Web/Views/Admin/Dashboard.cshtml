@{ ViewData["Title"] = "Admin Dashboard"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 style="font-size:1.15rem;font-weight:700;color:var(--text);margin:0 0 4px">Admin Dashboard</h4>
        <p style="color:var(--text-muted);font-size:.83rem;margin:0">Platform overview and user management</p>
    </div>
    <a asp-action="CreateUser" class="btn-ims btn-ims-danger"><i class="bi bi-person-plus me-1"></i>Add User</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:linear-gradient(135deg,#7c3aed,#4f46e5)">
                <i class="bi bi-mortarboard"></i>
            </div>
            <div>
                <div class="stat-label">Students</div>
                <div class="stat-value">@ViewBag.Students</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:linear-gradient(135deg,#059669,#10b981)">
                <i class="bi bi-person-check"></i>
            </div>
            <div>
                <div class="stat-label">Supervisors</div>
                <div class="stat-value">@ViewBag.Supervisors</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:linear-gradient(135deg,#d97706,#f59e0b)">
                <i class="bi bi-person-badge"></i>
            </div>
            <div>
                <div class="stat-label">Coordinators</div>
                <div class="stat-value">@ViewBag.Coordinators</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:linear-gradient(135deg,#dc2626,#ef4444)">
                <i class="bi bi-shield-lock"></i>
            </div>
            <div>
                <div class="stat-label">Admins</div>
                <div class="stat-value">@ViewBag.Admins</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:linear-gradient(135deg,#0891b2,#06b6d4)">
                <i class="bi bi-briefcase"></i>
            </div>
            <div>
                <div class="stat-label">Total Internships</div>
                <div class="stat-value">@ViewBag.TotalInternships</div>
            </div>
        </div>
    </div>
</div>

<div class="ims-card">
    <div class="ims-card-header">
        <span><i class="bi bi-lightning-charge me-2" style="color:var(--amber)"></i>Quick Actions</span>
    </div>
    <div class="ims-card-body">
        <div class="d-flex flex-wrap gap-3">
            <a asp-action="Users" class="btn-ims btn-ims-outline">
                <i class="bi bi-people me-1"></i>Manage Users
            </a>
            <a asp-action="CreateUser" class="btn-ims btn-ims-danger">
                <i class="bi bi-person-plus me-1"></i>Create User
            </a>
            <a asp-action="Users" asp-route-role="Student" class="btn-ims btn-ims-outline">
                <i class="bi bi-mortarboard me-1"></i>View Students
            </a>
            <a asp-action="Users" asp-route-role="Supervisor" class="btn-ims btn-ims-outline">
                <i class="bi bi-person-check me-1"></i>View Supervisors
            </a>
        </div>
    </div>
</div>
