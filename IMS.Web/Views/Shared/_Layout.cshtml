<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – NEXTERN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="/css/theme.css" rel="stylesheet" />
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    var role       = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var userName   = User.Identity.Name ?? "User";
    var initials   = userName.Length > 0 ? userName[0].ToString().ToUpper() : "U";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action     = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string c, string? a = null) =>
        controller == c && (a is null || action == a);

    <aside class="sidebar">

        <div class="sidebar-brand">
            <img src="/images/Nextern_Logo_DarkText_with_Subtitle.png" alt="NEXTERN" class="brand-logo" />
        </div>

        <nav class="sidebar-nav">
            @if (role == "Student")
            {
                <ul class="list-unstyled mb-0">
                    <li class="sidebar-label">Navigation</li>
                    <li class="nav-item">
                        <a class="nav-link-ims @(IsActive("Student","Dashboard") ? "active" : "")"
                           asp-controller="Student" asp-action="Dashboard">
                            <span class="nav-icon"><i class="bi bi-speedometer2"></i></span>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-ims @(IsActive("Student","Opportunities") ? "active" : "")"
                           asp-controller="Student" asp-action="Opportunities">
                            <span class="nav-icon"><i class="bi bi-megaphone"></i></span>Opportunities
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-ims @(IsActive("Student","ApplyInternship") || IsActive("Student","MyInternship") ? "active" : "")"
                           asp-controller="Student" asp-action="ApplyInternship">
                            <span class="nav-icon"><i class="bi bi-briefcase"></i></span>My Internship
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-ims @(IsActive("Student","Reports") ? "active" : "")"
                           asp-controller="Student" asp-action="Reports">
                            <span class="nav-icon"><i class="bi bi-journal-text"></i></span>My Tasks
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-ims @(IsActive("Student","Evaluations") ? "active" : "")"
                           asp-controller="Student" asp-action="Evaluations">
                            <span class="nav-icon"><i class="bi bi-star-half"></i></span>Evaluations
                        </a>
                    </li>
                </ul>
            }
            @if (role == "Supervisor")
            {
                <ul class="list-unstyled mb-0">
                    <li class="sidebar-label">Navigation</li>
                    <li class="nav-item">
                        <a class="nav-link-ims @(IsActive("Supervisor","Dashboard") ? "active" : "")"
                           asp-controller="Supervisor" asp-action="Dashboard">
                            <span class="nav-icon"><i class="bi bi-speedometer2"></i></span>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-ims @(IsActive("Supervisor","Interns") ? "active" : "")"
                           asp-controller="Supervisor" asp-action="Interns">
                            <span class="nav-icon"><i class="bi bi-people"></i></span>My Interns
                        </a>
                    </li>
                </ul>
            }
            @if (role == "Coordinator")
            {
                <ul class="list-unstyled mb-0">
                    <li class="sidebar-label">Navigation</li>
                    <li class="nav-item">
                        <a class="nav-link-ims @(IsActive("Coordinator","Dashboard") ? "active" : "")"
                           asp-controller="Coordinator" asp-action="Dashboard">
                            <span class="nav-icon"><i class="bi bi-speedometer2"></i></span>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-ims @(IsActive("Coordinator","Internships") ? "active" : "")"
                           asp-controller="Coordinator" asp-action="Internships">
                            <span class="nav-icon"><i class="bi bi-briefcase"></i></span>Internships
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-ims @(IsActive("Coordinator","Opportunities") ? "active" : "")"
                           asp-controller="Coordinator" asp-action="Opportunities">
                            <span class="nav-icon"><i class="bi bi-megaphone"></i></span>Opportunities
                        </a>
                    </li>
                </ul>
            }
            @if (role == "Admin")
            {
                <ul class="list-unstyled mb-0">
                    <li class="sidebar-label">Navigation</li>
                    <li class="nav-item">
                        <a class="nav-link-ims @(IsActive("Admin","Dashboard") ? "active" : "")"
                           asp-controller="Admin" asp-action="Dashboard">
                            <span class="nav-icon"><i class="bi bi-speedometer2"></i></span>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-ims @(IsActive("Admin","Users") ? "active" : "")"
                           asp-controller="Admin" asp-action="Users">
                            <span class="nav-icon"><i class="bi bi-people"></i></span>Manage Users
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-ims @(IsActive("Admin","CreateUser") ? "active" : "")"
                           asp-controller="Admin" asp-action="CreateUser">
                            <span class="nav-icon"><i class="bi bi-person-plus"></i></span>Add User
                        </a>
                    </li>
                </ul>
            }
        </nav>

        <div class="sidebar-footer">
            <ul class="list-unstyled mb-0">
                <li class="sidebar-label" style="padding-top:6px">Account</li>
                <li class="nav-item">
                    <a asp-controller="Account" asp-action="ChangePassword" class="nav-link-ims">
                        <span class="nav-icon"><i class="bi bi-shield-lock"></i></span>Change Password
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Account" asp-action="Logout" class="nav-link-ims" style="color:var(--red)">
                        <span class="nav-icon"><i class="bi bi-box-arrow-left"></i></span>Sign Out
                    </a>
                </li>
            </ul>
            <div class="sidebar-user">
                <div class="sidebar-user-avatar">@initials</div>
                <div style="min-width:0">
                    <div class="sidebar-user-name text-truncate">@userName</div>
                    <div class="sidebar-user-role">@role</div>
                </div>
                <div style="margin-left:auto;width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 6px var(--green);flex-shrink:0"></div>
            </div>
        </div>

    </aside>

    <header class="topbar">
        <div class="topbar-title">
            <i class="bi bi-house-door" style="color:var(--text-dim);font-size:.85rem"></i>
            <span style="color:var(--text-dim);font-size:.85rem">/</span>
            <span class="page-name">@ViewData["Title"]</span>
        </div>
        <div class="topbar-right">
            <a asp-controller="Account" asp-action="ChangePassword" class="topbar-icon-btn" title="Settings">
                <i class="bi bi-gear" style="font-size:14px"></i>
            </a>
            <div class="topbar-user">
                <div class="topbar-avatar">@initials</div>
                <div style="line-height:1.25">
                    <div style="font-size:.8rem;font-weight:700;color:var(--text)">@userName</div>
                    <div style="font-size:.68rem;color:var(--text-muted)">@role</div>
                </div>
            </div>
        </div>
    </header>

    <main class="main-content">
        @RenderBody()
    </main>

    @if (TempData["Success"] is string successMsg || TempData["Error"] is string errorMsg)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:9999">
            @if (TempData["Success"] is string sMsg)
            {
                <div id="toast-success" class="toast ims-toast show align-items-center" role="alert" data-bs-autohide="true" data-bs-delay="4000">
                    <div class="toast-body d-flex align-items-center gap-3">
                        <div style="width:36px;height:36px;border-radius:50%;background:rgba(16,185,129,.15);border:1px solid rgba(16,185,129,.3);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                            <i class="bi bi-check-circle-fill" style="color:var(--green)"></i>
                        </div>
                        <div>
                            <div style="font-size:.78rem;font-weight:700;color:var(--green);margin-bottom:2px">Success</div>
                            <div style="font-size:.85rem;color:var(--text)">@sMsg</div>
                        </div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="toast" style="flex-shrink:0"></button>
                    </div>
                </div>
            }
            @if (TempData["Error"] is string eMsg)
            {
                <div id="toast-error" class="toast ims-toast show align-items-center" role="alert" data-bs-autohide="true" data-bs-delay="5000">
                    <div class="toast-body d-flex align-items-center gap-3">
                        <div style="width:36px;height:36px;border-radius:50%;background:rgba(239,68,68,.15);border:1px solid rgba(239,68,68,.3);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                            <i class="bi bi-exclamation-triangle-fill" style="color:var(--red)"></i>
                        </div>
                        <div>
                            <div style="font-size:.78rem;font-weight:700;color:var(--red);margin-bottom:2px">Error</div>
                            <div style="font-size:.85rem;color:var(--text)">@eMsg</div>
                        </div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="toast" style="flex-shrink:0"></button>
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Auto-init toasts
    document.querySelectorAll('.toast').forEach(el => new bootstrap.Toast(el).show());
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
