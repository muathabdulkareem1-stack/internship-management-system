@{ ViewData["Title"] = "Supervisor Dashboard"; }
@{
    var interns = ViewBag.Interns as List<IMS.Web.Models.Internship> ?? [];
    int pendingReports = ViewBag.PendingReports ?? 0;
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:linear-gradient(135deg,#7c3aed,#4f46e5)">
                <i class="bi bi-people"></i>
            </div>
            <div>
                <div class="stat-label">Active Interns</div>
                <div class="stat-value">@interns.Count</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:linear-gradient(135deg,#d97706,#f59e0b)">
                <i class="bi bi-journal-text"></i>
            </div>
            <div>
                <div class="stat-label">Pending Reports</div>
                <div class="stat-value">@pendingReports</div>
            </div>
        </div>
    </div>
</div>

<div class="ims-card">
    <div class="ims-card-header">
        <span><i class="bi bi-people me-2" style="color:var(--purple)"></i>My Interns</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr><th>Student</th><th>Company</th><th>Position</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
            @if (!interns.Any())
            {
                <tr>
                    <td colspan="5" style="text-align:center;padding:40px;color:var(--text-muted)">
                        <i class="bi bi-people" style="font-size:2rem;display:block;margin-bottom:8px;opacity:.3"></i>
                        No interns assigned yet.
                    </td>
                </tr>
            }
            @foreach (var i in interns)
            {
                <tr>
                    <td style="font-weight:500">@i.Student?.FullName</td>
                    <td style="color:var(--text-muted)">@i.CompanyName</td>
                    <td style="color:var(--text-muted)">@i.Position</td>
                    <td><span class="badge bg-success">@i.Status</span></td>
                    <td>
                        <div class="d-flex gap-1 flex-wrap">
                            <a asp-action="InternReports" asp-route-internshipId="@i.Id" class="btn-ims btn-ims-outline" style="font-size:.78rem;padding:5px 10px">
                                <i class="bi bi-journal-text me-1"></i>Reports
                            </a>
                            <a asp-action="Evaluate" asp-route-internshipId="@i.Id" class="btn-ims btn-ims-warning" style="font-size:.78rem;padding:5px 10px">
                                <i class="bi bi-star me-1"></i>Evaluate
                            </a>
                            <button class="btn-ims btn-ims-primary" style="font-size:.78rem;padding:5px 10px"
                                    onclick="loadSupervisorAI(@i.Id, '@i.Student?.FullName')">
                                <i class="bi bi-stars me-1"></i>AI
                            </button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="aiModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-stars me-2" style="color:var(--purple)"></i>AI Skill Gap — <span id="aiModalName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="aiModalBody">
                <div style="text-align:center;padding:40px"><div class="spinner-border" style="color:var(--purple)"></div></div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
Chart.defaults.color = '#94a3b8';
Chart.defaults.borderColor = 'rgba(139,92,246,.1)';
let skillBarChart = null, evalLineChart = null, taskLineChart = null;

async function loadSupervisorAI(internshipId, studentName) {
    document.getElementById('aiModalName').textContent = studentName;
    document.getElementById('aiModalBody').innerHTML =
        '<div style="text-align:center;padding:40px"><div class="spinner-border" style="color:var(--purple)"></div><div style="margin-top:12px;color:var(--text-muted);font-size:.85rem">AI analyzing skill gaps...</div></div>';
    new bootstrap.Modal(document.getElementById('aiModal')).show();

    try {
        const res  = await fetch(`/Supervisor/GetAIInsight?internshipId=${internshipId}`);
        if (!res.ok) throw new Error(`Server returned ${res.status}`);
        const data = await res.json();
        if (data.error) {
            document.getElementById('aiModalBody').innerHTML = `<div class="alert alert-warning">${data.error}</div>`; return;
        }

        const ratingColor = data.overallRating === 'Excellent' ? '#10b981' : data.overallRating === 'Good' ? '#f59e0b' : '#ef4444';
        const scores = data.skillScores     || [];
        const evalT  = data.evalTrend       || [];
        const taskT  = data.taskRatingTrend || [];
        const labels = scores.map(s => s.skill);
        const values = scores.map(s => s.rating);

        document.getElementById('aiModalBody').innerHTML = `
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <div style="background:var(--bg3);border:1px solid var(--card-border);border-radius:var(--radius);padding:18px;height:100%">
                <div style="font-size:.7rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;margin-bottom:12px"><i class="bi bi-stars me-1"></i>Skill Gap Analysis</div>
                <p style="font-size:.88rem;margin-bottom:10px">${data.skillGapSummary}</p>
                <div style="font-size:.82rem;margin-bottom:6px"><i class="bi bi-star-fill me-1" style="color:var(--amber)"></i>Strongest: <strong>${data.strongestSkill||'—'}</strong></div>
                <div style="font-size:.82rem;margin-bottom:10px"><i class="bi bi-arrow-up-circle me-1" style="color:var(--red)"></i>Needs Work: <strong>${data.weakestSkill||'—'}</strong></div>
                <div style="font-size:.8rem;color:var(--text-muted);margin-bottom:10px">${data.taskPerformanceSummary}</div>
                <div style="background:rgba(139,92,246,.1);border:1px solid rgba(139,92,246,.2);border-radius:8px;padding:8px 12px;font-size:.82rem;margin-bottom:10px;color:var(--purple)">
                  <i class="bi bi-lightbulb me-1"></i>${data.suggestedFocus}
                </div>
                <span style="background:${ratingColor};color:#fff;padding:4px 12px;border-radius:20px;font-size:.8rem;font-weight:600">${data.overallRating}</span>
              </div>
            </div>
            <div class="col-md-6">
              <div style="background:var(--bg3);border:1px solid var(--card-border);border-radius:var(--radius);padding:18px;height:100%">
                <div style="font-size:.7rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;margin-bottom:12px"><i class="bi bi-bar-chart me-1"></i>Skill Scores</div>
                ${labels.length > 0 ? `<canvas id="skillBarChart" height="200"></canvas>` : `<div style="text-align:center;padding:40px 0;color:var(--text-muted);font-size:.85rem">No evaluations yet</div>`}
              </div>
            </div>
          </div>
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <div style="background:var(--bg3);border:1px solid var(--card-border);border-radius:var(--radius);padding:18px">
                <div style="font-size:.7rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;margin-bottom:12px"><i class="bi bi-graph-up me-1"></i>Monthly Eval Trend</div>
                ${evalT.length > 0 ? `<canvas id="evalLineChart" height="160"></canvas>` : `<div style="text-align:center;padding:30px 0;color:var(--text-muted);font-size:.85rem">No monthly data</div>`}
              </div>
            </div>
            <div class="col-md-6">
              <div style="background:var(--bg3);border:1px solid var(--card-border);border-radius:var(--radius);padding:18px">
                <div style="font-size:.7rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;margin-bottom:12px"><i class="bi bi-clipboard-check me-1"></i>Task Rating Trend</div>
                ${taskT.length > 0 ? `<canvas id="taskLineChart" height="160"></canvas>` : `<div style="text-align:center;padding:30px 0;color:var(--text-muted);font-size:.85rem">No task ratings yet</div>`}
              </div>
            </div>
          </div>
          ${scores.length > 0 ? `
          <div style="background:var(--bg3);border:1px solid var(--card-border);border-radius:var(--radius);padding:18px">
            <div style="font-size:.7rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;margin-bottom:12px"><i class="bi bi-list-check me-1"></i>Detailed Feedback</div>
            ${scores.map(s => `
              <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--card-border)">
                <div>
                  <div style="font-weight:600;font-size:.88rem">${s.skill}</div>
                  <div style="color:var(--text-muted);font-size:.8rem">${s.comment}</div>
                </div>
                <div style="display:flex;align-items:center;gap:10px">
                  <div class="progress" style="width:80px;height:6px">
                    <div class="progress-bar" style="width:${s.rating*20}%;background:${s.rating>=4?'#10b981':s.rating>=3?'#f59e0b':'#ef4444'}"></div>
                  </div>
                  <span style="font-weight:700;font-size:.85rem;min-width:28px">${s.rating}/5</span>
                </div>
              </div>`).join('')}
          </div>` : ''}`;

        if (skillBarChart) skillBarChart.destroy();
        if (evalLineChart) evalLineChart.destroy();
        if (taskLineChart) taskLineChart.destroy();

        if (labels.length > 0) {
            skillBarChart = new Chart(document.getElementById('skillBarChart'), {
                type: 'bar',
                data: { labels, datasets: [{ label:'Rating', data:values,
                    backgroundColor: values.map(v => v>=4?'#10b981':v>=3?'#f59e0b':'#ef4444'),
                    borderRadius: 4 }] },
                options: {
                    indexAxis:'y',
                    scales: { x: { min:0, max:5, ticks:{stepSize:1,font:{size:9}}, grid:{color:'rgba(139,92,246,.1)'} },
                              y: { ticks:{font:{size:9}}, grid:{color:'rgba(139,92,246,.05)'} } },
                    plugins: { legend:{display:false} }
                }
            });
        }
        if (evalT.length > 0) {
            evalLineChart = new Chart(document.getElementById('evalLineChart'), {
                type:'line',
                data: { labels:evalT.map(e=>e.label), datasets:[{ data:evalT.map(e=>e.avgRating),
                    borderColor:'#8b5cf6', backgroundColor:'rgba(139,92,246,.1)', fill:true, tension:0.3, pointRadius:4, pointBackgroundColor:'#8b5cf6' }] },
                options: { scales:{ y:{min:0,max:5,ticks:{stepSize:1,font:{size:9}},grid:{color:'rgba(139,92,246,.1)'}},
                    x:{ticks:{font:{size:9}},grid:{color:'rgba(139,92,246,.05)'}} }, plugins:{legend:{display:false}} }
            });
        }
        if (taskT.length > 0) {
            taskLineChart = new Chart(document.getElementById('taskLineChart'), {
                type:'line',
                data: { labels:taskT.map(t=>t.label), datasets:[{ data:taskT.map(t=>t.rating),
                    borderColor:'#06b6d4', backgroundColor:'rgba(6,182,212,.1)', fill:true, tension:0.3, pointRadius:4, pointBackgroundColor:'#06b6d4' }] },
                options: { scales:{ y:{min:0,max:5,ticks:{stepSize:1,font:{size:9}},grid:{color:'rgba(139,92,246,.1)'}},
                    x:{ticks:{font:{size:9}},grid:{color:'rgba(139,92,246,.05)'}} }, plugins:{legend:{display:false}} }
            });
        }
    } catch(e) {
        document.getElementById('aiModalBody').innerHTML = `<div class="alert alert-danger"><strong>Error:</strong> ${e.message}</div>`;
    }
}
</script>
