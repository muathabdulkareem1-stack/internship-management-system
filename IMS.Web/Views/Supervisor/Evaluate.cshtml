@using IMS.Web.Models
@{
    ViewData["Title"] = "Monthly Evaluation";
    var internship   = ViewBag.Internship as Internship;
    var skills       = ViewBag.Skills as List<Skill> ?? [];
    var months       = ViewBag.Months as List<(int Month, int Year, string Label)> ?? [];
    var evaluatedSet = ViewBag.EvaluatedSet as HashSet<(int Month, int Year)> ?? [];
    var history      = ViewBag.History as List<Evaluation> ?? [];
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Interns" class="btn-ims btn-ims-outline" style="padding:7px 12px"><i class="bi bi-arrow-left"></i></a>
    <div>
        <h4 style="font-size:1.1rem;font-weight:700;color:var(--text);margin:0">
            <i class="bi bi-calendar-check me-2" style="color:var(--amber)"></i>Monthly Evaluation
        </h4>
        <div style="font-size:.82rem;color:var(--text-muted)">@internship?.Student?.FullName — @internship?.CompanyName</div>
    </div>
</div>

<div class="row g-4">

    <div class="col-md-7">
        <div class="ims-card">
            <div class="ims-card-header">
                <span><i class="bi bi-plus-circle me-2" style="color:var(--amber)"></i>New Monthly Evaluation</span>
            </div>
            <div class="ims-card-body">
                <form asp-action="Evaluate" method="post">
                    <input type="hidden" name="internshipId" value="@internship?.Id" />

                    <div class="mb-4">
                        <label class="form-label">Month</label>
                        <select name="" class="form-select" id="monthYearSelect" required
                                onchange="setMonthYear(this.value)">
                            <option value="">— Select month —</option>
                            @foreach (var (m, y, label) in months)
                            {
                                var done = evaluatedSet.Contains((m, y));
                                if (done)
                                {
                                    <option value="@m|@y" disabled="disabled">@label ✓ already evaluated</option>
                                }
                                else
                                {
                                    <option value="@m|@y">@label</option>
                                }
                            }
                        </select>
                        <input type="hidden" name="month" id="hiddenMonth" />
                        <input type="hidden" name="year"  id="hiddenYear"  />
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Skill Ratings</label>
                        @for (int i = 0; i < skills.Count; i++)
                        {
                            <div style="background:var(--bg3);border:1px solid var(--card-border);border-radius:8px;padding:14px 16px;margin-bottom:10px">
                                <div style="font-weight:600;font-size:.88rem;margin-bottom:10px">
                                    @skills[i].Name
                                    <span style="color:var(--text-muted);font-weight:400;font-size:.8rem"> (@skills[i].Category)</span>
                                </div>
                                <input type="hidden" name="skillIds" value="@skills[i].Id" />
                                <div class="d-flex gap-2 flex-wrap">
                                    @for (int r = 1; r <= 5; r++)
                                    {
                                        <div class="form-check form-check-inline" style="margin:0">
                                            <input class="form-check-input" type="radio"
                                                   name="ratings[@i]" value="@r"
                                                   id="s@(i)r@(r)" required />
                                            <label class="form-check-label" for="s@(i)r@(r)" style="font-size:.85rem">@r</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Comments</label>
                        <textarea name="comments" class="form-control" rows="3"
                            placeholder="Overall feedback for this month..."></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-ims btn-ims-warning">
                            <i class="bi bi-send me-1"></i>Submit Evaluation
                        </button>
                        <a asp-action="Interns" class="btn-ims btn-ims-outline">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="ims-card">
            <div class="ims-card-header">
                <span><i class="bi bi-clock-history me-2" style="color:var(--cyan)"></i>Evaluation History</span>
            </div>
            <div style="max-height:520px;overflow-y:auto">
                @if (!history.Any())
                {
                    <div style="text-align:center;padding:32px;color:var(--text-muted);font-size:.85rem">No evaluations yet.</div>
                }
                @foreach (var e in history)
                {
                    var monthName = new DateTime(e.Year, e.Month, 1).ToString("MMMM yyyy");
                    var avg = e.EvaluationSkills.Any() ? e.EvaluationSkills.Average(es => es.Rating) : 0;
                    var avgColor = avg >= 4 ? "var(--green)" : avg >= 3 ? "var(--amber)" : "var(--red)";
                    <div style="padding:14px 16px;border-bottom:1px solid var(--card-border)">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
                            <span style="font-weight:600;font-size:.88rem">@monthName</span>
                            <span style="font-size:.82rem;font-weight:700;color:@avgColor">Avg: @avg.ToString("0.0") / 5</span>
                        </div>
                        @foreach (var es in e.EvaluationSkills)
                        {
                            var barColor = es.Rating >= 4 ? "var(--green)" : es.Rating >= 3 ? "var(--amber)" : "var(--red)";
                            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
                                <small style="color:var(--text-muted)">@es.Skill?.Name</small>
                                <div style="display:flex;align-items:center;gap:8px">
                                    <div class="progress" style="width:60px;height:4px;border-radius:2px">
                                        <div class="progress-bar" style="width:@(es.Rating * 20)%;background:@barColor"></div>
                                    </div>
                                    <small style="color:var(--text-muted);min-width:14px">@es.Rating</small>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(e.Comments))
                        {
                            <div style="font-size:.8rem;color:var(--text-muted);margin-top:6px;font-style:italic">"@e.Comments"</div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

</div>

<script>
    function setMonthYear(val) {
        if (!val) return;
        const parts = val.split('|');
        document.getElementById('hiddenMonth').value = parts[0];
        document.getElementById('hiddenYear').value  = parts[1];
    }
</script>
