@model IMS.Web.Models.Assignment
@{ ViewData["Title"] = "Edit Task"; }

<div class="row justify-content-center">
    <div class="col-md-7">

        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-action="InternReports" asp-route-internshipId="@Model.InternshipId"
               class="btn-ims btn-ims-outline" style="padding:7px 12px">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h4 style="font-size:1.1rem;font-weight:700;color:var(--text);margin:0">
                    <i class="bi bi-pencil-square me-2" style="color:var(--amber)"></i>Edit Task
                </h4>
                <div style="font-size:.82rem;color:var(--text-muted)">@Model.Internship?.Student?.FullName</div>
            </div>
        </div>

        <div class="ims-card">
            <div class="ims-card-body">
                <form asp-action="EditTask" asp-route-assignmentId="@Model.Id"
                      method="post" enctype="multipart/form-data">

                    <div class="mb-3">
                        <label class="form-label">Task Title</label>
                        <input name="Title" class="form-control" value="@Model.Title" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="Description" class="form-control" rows="5" required>@Model.Description</textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Due Date</label>
                        <input name="DueDate" type="date" class="form-control"
                               value="@Model.DueDate.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Task Attachment</label>
                        @if (Model.AttachmentPath is not null)
                        {
                            <div style="font-size:.8rem;color:var(--text-muted);margin-bottom:6px">
                                <i class="bi bi-paperclip me-1"></i>Current: <strong>@Model.AttachmentName</strong>
                                — upload a new file to replace it.
                            </div>
                        }
                        <input name="attachment" type="file" class="form-control" />
                        <div class="form-text">Optional. Replaces the existing file if provided.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-ims btn-ims-warning">
                            <i class="bi bi-floppy me-1"></i>Save Changes
                        </button>
                        <a asp-action="InternReports" asp-route-internshipId="@Model.InternshipId"
                           class="btn-ims btn-ims-outline">Cancel</a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>
