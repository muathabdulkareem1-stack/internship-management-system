@model List<IMS.Web.Models.Internship>
@{ ViewData["Title"] = "My Interns"; }

<div class="mb-4">
    <h4 style="font-size:1.15rem;font-weight:700;color:var(--text);margin:0 0 4px">Assigned Interns</h4>
    <p style="color:var(--text-muted);font-size:.83rem;margin:0">Manage tasks, reports, and evaluations for your interns</p>
</div>

<div class="ims-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Company</th>
                    <th>Position</th>
                    <th>Period</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" style="text-align:center;padding:40px;color:var(--text-muted)">
                        <i class="bi bi-people" style="font-size:2rem;display:block;margin-bottom:8px;opacity:.3"></i>
                        No interns assigned yet.
                    </td>
                </tr>
            }
            @foreach (var i in Model)
            {
                <tr>
                    <td style="font-weight:600">@i.Student?.FullName</td>
                    <td style="color:var(--text-muted)">@i.CompanyName</td>
                    <td style="color:var(--text-muted)">@i.Position</td>
                    <td style="font-size:.82rem;color:var(--text-muted)">@i.StartDate – @i.EndDate</td>
                    <td>
                        <span class="badge @(i.Status == IMS.Web.Enums.InternshipStatus.Approved ? "bg-success" : "bg-secondary")">
                            @i.Status
                        </span>
                    </td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            <a asp-action="AssignTask" asp-route-internshipId="@i.Id"
                               class="btn-ims btn-ims-success" style="font-size:.78rem;padding:5px 10px">
                                <i class="bi bi-clipboard-plus me-1"></i>Assign Task
                            </a>
                            <a asp-action="InternReports" asp-route-internshipId="@i.Id"
                               class="btn-ims btn-ims-outline" style="font-size:.78rem;padding:5px 10px">
                                <i class="bi bi-journal-text me-1"></i>Tasks
                            </a>
                            <a asp-action="Evaluate" asp-route-internshipId="@i.Id"
                               class="btn-ims btn-ims-warning" style="font-size:.78rem;padding:5px 10px">
                                <i class="bi bi-star me-1"></i>Evaluate
                            </a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
