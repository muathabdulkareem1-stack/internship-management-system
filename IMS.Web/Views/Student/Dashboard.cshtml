@{ ViewData["Title"] = "Student Dashboard"; }
@{
    var internship       = ViewBag.Internship  as IMS.Web.Models.Internship;
    var assignments      = ViewBag.Assignments as List<IMS.Web.Models.Assignment> ?? [];
    var evaluations      = ViewBag.Evaluations as List<IMS.Web.Models.Evaluation> ?? [];
    int totalHours       = ViewBag.TotalHoursWorked ?? 0;
    int requiredHours    = ViewBag.RequiredHours ?? 300;
    int hoursPercent     = requiredHours > 0 ? Math.Min(100, totalHours * 100 / requiredHours) : 0;
}

@if (ViewBag.WasCancelled == true)
{
    <div class="alert alert-warning d-flex align-items-center justify-content-between mb-4">
        <div><i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Your internship was removed by the coordinator.</strong> You can apply for a new one.</div>
        <div class="d-flex gap-2">
            <a asp-action="Opportunities" class="btn-ims btn-ims-primary"><i class="bi bi-search me-1"></i>Browse</a>
            <a asp-action="ApplyInternship" class="btn-ims btn-ims-outline"><i class="bi bi-pencil me-1"></i>Apply Own</a>
        </div>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:linear-gradient(135deg,#7c3aed,#4f46e5)">
                <i class="bi bi-briefcase"></i>
            </div>
            <div>
                <div class="stat-label">Internship Status</div>
                @if (internship is null)
                {
                    <span class="badge bg-secondary">Not Applied</span>
                }
                else
                {
                    <span class="badge @(internship.Status == IMS.Web.Enums.InternshipStatus.Approved ? "bg-success" : internship.Status == IMS.Web.Enums.InternshipStatus.Rejected ? "bg-danger" : "bg-warning text-dark")">@internship.Status</span>
                }
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:linear-gradient(135deg,#059669,#10b981)">
                <i class="bi bi-journal-check"></i>
            </div>
            <div>
                <div class="stat-label">Tasks Assigned</div>
                <div class="stat-value">@assignments.Count</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon" style="background:linear-gradient(135deg,#d97706,#f59e0b)">
                <i class="bi bi-star-half"></i>
            </div>
            <div>
                <div class="stat-label">Evaluations</div>
                <div class="stat-value">@evaluations.Count</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="flex-direction:column;align-items:flex-start;gap:10px">
            <div class="d-flex align-items-center gap-3 w-100">
                <div class="stat-icon" style="background:linear-gradient(135deg,#0891b2,#06b6d4)">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div>
                    <div class="stat-label">Hours Logged</div>
                    <div class="stat-value">@totalHours <span style="font-size:.8rem;font-weight:400;color:var(--text-muted)">/ @requiredHours h</span></div>
                </div>
            </div>
            <div class="w-100">
                <div class="progress" style="height:5px;border-radius:3px">
                    <div class="progress-bar @(hoursPercent >= 100 ? "" : "")"
                         style="width:@hoursPercent%;background:var(--cyan)"></div>
                </div>
                <div style="font-size:.72rem;color:var(--text-muted);margin-top:4px">@hoursPercent% complete</div>
            </div>
        </div>
    </div>
</div>

@if (internship is not null)
{
    <div class="ims-card mb-4">
        <div class="ims-card-header">
            <span><i class="bi bi-briefcase me-2" style="color:var(--purple)"></i>My Internship</span>
            <div class="d-flex gap-2">
                @if (internship.Status == IMS.Web.Enums.InternshipStatus.Pending)
                {
                    <form asp-action="WithdrawApplication" method="post"
                          onsubmit="return confirm('Withdraw your application? This cannot be undone.')">
                        <input type="hidden" name="internshipId" value="@internship.Id" />
                        <button class="btn-ims btn-ims-danger"><i class="bi bi-x-circle me-1"></i>Withdraw</button>
                    </form>
                }
                @if (internship.Status == IMS.Web.Enums.InternshipStatus.Rejected)
                {
                    <form asp-action="DismissRejection" method="post"
                          onsubmit="return confirm('Clear rejection so you can apply again?')">
                        <input type="hidden" name="internshipId" value="@internship.Id" />
                        <button class="btn-ims btn-ims-warning"><i class="bi bi-arrow-repeat me-1"></i>Apply Again</button>
                    </form>
                }
            </div>
        </div>
        <div class="ims-card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div style="color:var(--text-muted);font-size:.78rem;margin-bottom:3px">Company</div>
                    <div style="font-weight:600">@internship.CompanyName</div>
                </div>
                <div class="col-md-6">
                    <div style="color:var(--text-muted);font-size:.78rem;margin-bottom:3px">Position</div>
                    <div>@internship.Position</div>
                </div>
                <div class="col-md-6">
                    <div style="color:var(--text-muted);font-size:.78rem;margin-bottom:3px">Period</div>
                    <div>@internship.StartDate – @internship.EndDate</div>
                </div>
                <div class="col-md-6">
                    <div style="color:var(--text-muted);font-size:.78rem;margin-bottom:3px">Supervisor</div>
                    <div>@(internship.Supervisor?.FullName ?? "Not assigned yet")</div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="ims-card mb-4">
        <div class="ims-card-body">
            <div class="empty-state">
                <i class="bi bi-briefcase" style="font-size:2.5rem;color:var(--purple);opacity:.5"></i>
                <div style="margin-top:12px;font-weight:600;color:var(--text)">No internship yet</div>
                <div style="color:var(--text-muted);font-size:.85rem;margin-bottom:16px">Browse opportunities or apply with your own</div>
                <div class="d-flex gap-2 justify-content-center">
                    <a asp-action="Opportunities" class="btn-ims btn-ims-primary"><i class="bi bi-search me-1"></i>Browse Opportunities</a>
                    <a asp-action="ApplyInternship" class="btn-ims btn-ims-outline"><i class="bi bi-pencil me-1"></i>Apply Own</a>
                </div>
            </div>
        </div>
    </div>
}

@if (internship?.Status == IMS.Web.Enums.InternshipStatus.Approved)
{
    <div class="ims-card mb-4" id="aiCard">
        <div class="ims-card-header">
            <span><i class="bi bi-stars me-2" style="color:var(--purple)"></i>AI Progress Insights</span>
            <button class="btn-ims btn-ims-primary" onclick="loadStudentAI()" id="aiBtn">
                <i class="bi bi-stars me-1"></i>Generate Insights
            </button>
        </div>
        <div class="ims-card-body" id="aiBody">
            <div style="text-align:center;padding:32px;color:var(--text-muted)">
                <i class="bi bi-stars" style="font-size:2.5rem;color:var(--purple);opacity:.4;display:block;margin-bottom:12px"></i>
                <div style="font-size:.85rem">Click "Generate Insights" for an AI-powered analysis of your progress.</div>
            </div>
        </div>
    </div>
}

@if (assignments.Any())
{
    <div class="ims-card">
        <div class="ims-card-header">
            <span><i class="bi bi-clipboard-check me-2" style="color:var(--cyan)"></i>Recent Tasks</span>
            <a asp-action="Reports" class="btn-ims btn-ims-outline"><i class="bi bi-arrow-right me-1"></i>View All</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Task</th>
                        <th>Due Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var a in assignments)
                {
                    <tr>
                        <td style="font-weight:500">@a.Title</td>
                        <td style="color:var(--text-muted);font-size:.85rem">@a.DueDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (a.Report is null)
                            {
                                <span class="badge bg-secondary">Pending</span>
                            }
                            else if (a.Report.Status == IMS.Web.Enums.ReportStatus.Reviewed)
                            {
                                <span class="badge bg-success">Reviewed</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Submitted</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
Chart.defaults.color = '#94a3b8';
Chart.defaults.borderColor = 'rgba(139,92,246,.1)';
let taskDonut = null, skillRadar = null, hoursLine = null;

async function loadStudentAI() {
    const btn  = document.getElementById('aiBtn');
    const body = document.getElementById('aiBody');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Analyzing...';
    body.innerHTML = '<div style="text-align:center;padding:40px"><div class="spinner-border" style="color:var(--purple)"></div><div style="margin-top:12px;color:var(--text-muted);font-size:.85rem">AI is analyzing your progress...</div></div>';

    try {
        const res  = await fetch('/Student/GetAIInsight');
        if (!res.ok) throw new Error(`Server returned ${res.status}`);
        const data = await res.json();
        if (data.error) {
            body.innerHTML = `<div class="alert alert-warning"><i class="bi bi-exclamation-circle me-1"></i>${data.error}</div>`;
            btn.disabled = false; btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Retry'; return;
        }

        const riskColor = data.riskLevel === 'high' ? '#ef4444' : data.riskLevel === 'medium' ? '#f59e0b' : '#10b981';
        const riskBg    = data.riskLevel === 'high' ? 'rgba(239,68,68,.1)' : data.riskLevel === 'medium' ? 'rgba(245,158,11,.1)' : 'rgba(16,185,129,.1)';
        const riskIcon  = data.riskLevel === 'high' ? 'bi-exclamation-triangle-fill' : data.riskLevel === 'medium' ? 'bi-exclamation-circle' : 'bi-check-circle-fill';
        const tb = data.taskBreakdown || { reviewed:0, submitted:0, rejected:0, pending:0 };
        const ss = data.skillScores   || [];
        const ht = data.hoursTimeline || [];

        body.innerHTML = `
          <div class="row g-3 mb-3">
            <div class="col-md-8">
              <div style="background:var(--bg3);border:1px solid var(--card-border);border-radius:var(--radius);padding:20px;height:100%">
                <div style="font-size:.72rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:12px"><i class="bi bi-chat-text me-1"></i>AI Summary</div>
                <p style="color:var(--text);margin-bottom:12px">${data.summary}</p>
                <div style="background:${riskBg};border:1px solid ${riskColor}30;border-radius:8px;padding:8px 12px;margin-bottom:10px;font-size:.83rem">
                  <i class="bi ${riskIcon} me-1" style="color:${riskColor}"></i>
                  <strong style="color:${riskColor}">Risk Level: ${(data.riskLevel||'').toUpperCase()}</strong>
                  <span style="color:var(--text-muted)"> — ${data.riskReason}</span>
                </div>
                <div style="font-size:.83rem;color:var(--purple)"><i class="bi bi-lightbulb me-1"></i><strong>Recommendation:</strong> ${data.recommendation}</div>
              </div>
            </div>
            <div class="col-md-4">
              <div style="background:var(--bg3);border:1px solid var(--card-border);border-radius:var(--radius);padding:20px;height:100%">
                <div style="font-size:.72rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:14px"><i class="bi bi-speedometer2 me-1"></i>Key Metrics</div>
                <div style="margin-bottom:14px">
                  <div style="display:flex;justify-content:space-between;margin-bottom:5px"><span style="font-size:.78rem;color:var(--text-muted)">Hours Progress</span><span style="font-size:.78rem">${data.hoursPercent}%</span></div>
                  <div class="progress" style="height:6px"><div class="progress-bar" style="width:${data.hoursPercent}%;background:var(--cyan)"></div></div>
                </div>
                <div style="margin-bottom:14px">
                  <div style="display:flex;justify-content:space-between;margin-bottom:5px"><span style="font-size:.78rem;color:var(--text-muted)">Task Completion</span><span style="font-size:.78rem">${data.taskCompletionRate}%</span></div>
                  <div class="progress" style="height:6px"><div class="progress-bar" style="width:${data.taskCompletionRate}%;background:var(--green)"></div></div>
                </div>
                ${data.averageSkillRating != null ? `<div style="margin-bottom:10px"><span style="font-size:.78rem;color:var(--text-muted)">Avg Skill Rating</span><div style="font-size:1.5rem;font-weight:700;color:var(--amber)">${data.averageSkillRating?.toFixed(1)} <span style="font-size:.85rem;font-weight:400;color:var(--text-muted)">/ 5</span></div></div>` : ''}
                ${data.topSkill     ? `<div style="font-size:.8rem;margin-bottom:6px"><i class="bi bi-star-fill me-1" style="color:var(--amber)"></i>Top: <strong>${data.topSkill}</strong></div>` : ''}
                ${data.weakestSkill ? `<div style="font-size:.8rem"><i class="bi bi-arrow-up-circle me-1" style="color:var(--red)"></i>Improve: <strong>${data.weakestSkill}</strong></div>` : ''}
              </div>
            </div>
          </div>

          <div class="row g-3">
            <div class="col-md-4">
              <div style="background:var(--bg3);border:1px solid var(--card-border);border-radius:var(--radius);padding:20px;height:100%">
                <div style="font-size:.72rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:12px"><i class="bi bi-pie-chart me-1"></i>Task Breakdown</div>
                <canvas id="taskDonutChart" height="200"></canvas>
                <div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:12px;font-size:.75rem">
                  <span><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:#10b981;margin-right:4px"></span>Reviewed (${tb.reviewed||0})</span>
                  <span><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:#f59e0b;margin-right:4px"></span>Submitted (${tb.submitted||0})</span>
                  <span><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:#ef4444;margin-right:4px"></span>Rejected (${tb.rejected||0})</span>
                  <span><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:#475569;margin-right:4px"></span>Pending (${tb.pending||0})</span>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div style="background:var(--bg3);border:1px solid var(--card-border);border-radius:var(--radius);padding:20px;height:100%">
                <div style="font-size:.72rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:12px"><i class="bi bi-diagram-3 me-1"></i>Skill Radar</div>
                ${ss.length > 0 ? `<canvas id="skillRadarChart" height="200"></canvas>` : `<div style="text-align:center;padding:40px 0;color:var(--text-muted);font-size:.85rem">No evaluations yet</div>`}
              </div>
            </div>
            <div class="col-md-4">
              <div style="background:var(--bg3);border:1px solid var(--card-border);border-radius:var(--radius);padding:20px;height:100%">
                <div style="font-size:.72rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:12px"><i class="bi bi-graph-up me-1"></i>Hours Over Time</div>
                ${ht.length > 0 ? `<canvas id="hoursLineChart" height="200"></canvas>` : `<div style="text-align:center;padding:40px 0;color:var(--text-muted);font-size:.85rem">No hours logged yet</div>`}
              </div>
            </div>
          </div>`;

        if (taskDonut) taskDonut.destroy();
        if (skillRadar) skillRadar.destroy();
        if (hoursLine)  hoursLine.destroy();

        taskDonut = new Chart(document.getElementById('taskDonutChart'), {
            type: 'doughnut',
            data: {
                labels: ['Reviewed', 'Submitted', 'Rejected', 'Pending'],
                datasets: [{ data: [tb.reviewed||0, tb.submitted||0, tb.rejected||0, tb.pending||0],
                    backgroundColor: ['#10b981','#f59e0b','#ef4444','#475569'],
                    borderColor: '#111827', borderWidth: 3 }]
            },
            options: { plugins: { legend: { display: false } }, cutout: '65%' }
        });

        if (ss.length > 0) {
            skillRadar = new Chart(document.getElementById('skillRadarChart'), {
                type: 'radar',
                data: {
                    labels: ss.map(s => s.skill),
                    datasets: [{
                        label: 'Rating',
                        data: ss.map(s => s.rating),
                        backgroundColor: 'rgba(139,92,246,0.2)',
                        borderColor: '#8b5cf6',
                        pointBackgroundColor: '#8b5cf6',
                        borderWidth: 2
                    }]
                },
                options: {
                    scales: { r: { min: 0, max: 5, ticks: { stepSize: 1, font: { size: 9 }, color:'#94a3b8', backdropColor:'transparent' },
                        grid: { color:'rgba(139,92,246,.15)' }, angleLines: { color:'rgba(139,92,246,.15)' }, pointLabels: { color:'#94a3b8', font:{size:10} } } },
                    plugins: { legend: { display: false } }
                }
            });
        }

        if (ht.length > 0) {
            hoursLine = new Chart(document.getElementById('hoursLineChart'), {
                type: 'line',
                data: {
                    labels: ht.map(h => h.label),
                    datasets: [{
                        label: 'Hours',
                        data: ht.map(h => h.hours),
                        borderColor: '#06b6d4',
                        backgroundColor: 'rgba(6,182,212,0.1)',
                        fill: true, tension: 0.3, pointRadius: 4, pointBackgroundColor: '#06b6d4'
                    }]
                },
                options: {
                    scales: {
                        y: { beginAtZero: true, grid: { color:'rgba(139,92,246,.1)' }, ticks: { font:{size:9} } },
                        x: { grid: { color:'rgba(139,92,246,.1)' }, ticks: { font:{size:9} } }
                    },
                    plugins: { legend: { display: false } }
                }
            });
        }

        btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Refresh';
    } catch(e) {
        document.getElementById('aiBody').innerHTML = `<div class="alert alert-danger"><strong>Error:</strong> ${e.message}</div>`;
    } finally {
        btn.disabled = false;
    }
}
</script>
