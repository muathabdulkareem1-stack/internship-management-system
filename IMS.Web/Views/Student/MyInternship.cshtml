@{
    ViewData["Title"] = "My Internship";
    var internship = ViewBag.Internship as IMS.Web.Models.Internship;

    var isApproved = internship?.Status == IMS.Web.Enums.InternshipStatus.Approved;
    var isRejected = internship?.Status == IMS.Web.Enums.InternshipStatus.Rejected;

    var statusColor     = isApproved ? "var(--green)"   : isRejected ? "var(--red)"   : "var(--amber)";
    var statusColorRgb  = isApproved ? "16,185,129"     : isRejected ? "239,68,68"    : "245,158,11";
    var statusIcon      = isApproved ? "bi-patch-check-fill" : isRejected ? "bi-x-octagon-fill" : "bi-hourglass-split";
    var statusTitle     = isApproved ? "Internship Approved"          : isRejected ? "Application Rejected"         : "Pending Review";
    var statusText      = isApproved ? "Congratulations! Your internship is active. Good luck!"
                        : isRejected ? "Your application was not approved by the coordinator."
                        : "Your application is under review. You'll be notified once a decision is made.";
}

<div class="mb-4">
    <h4 style="font-size:1.15rem;font-weight:700;color:var(--text);margin:0 0 4px">My Internship</h4>
    <p style="color:var(--text-muted);font-size:.83rem;margin:0">Track your internship status and details</p>
</div>

@if (internship is null)
{
    <div class="ims-card">
        <div class="ims-card-body">
            <div class="empty-state">
                <i class="bi bi-briefcase" style="font-size:2.5rem;color:var(--purple);opacity:.4"></i>
                <div style="margin-top:12px;font-weight:600;color:var(--text)">No internship yet</div>
                <div style="color:var(--text-muted);font-size:.85rem;margin-bottom:16px">You haven't applied for an internship yet.</div>
                <div class="d-flex gap-2 justify-content-center">
                    <a asp-action="Opportunities" class="btn-ims btn-ims-primary"><i class="bi bi-search me-1"></i>Browse Opportunities</a>
                    <a asp-action="ApplyInternship" class="btn-ims btn-ims-outline"><i class="bi bi-pencil me-1"></i>Apply Own</a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div style="display:flex;align-items:center;gap:16px;margin-bottom:24px;padding:16px 20px;border-radius:12px;background:linear-gradient(135deg,rgba(@(statusColorRgb),.08),rgba(@(statusColorRgb),.04));border:1px solid rgba(@(statusColorRgb),.25);box-shadow:0 0 24px rgba(@(statusColorRgb),.07),inset 0 1px 0 rgba(@(statusColorRgb),.1)">
        <div style="width:42px;height:42px;border-radius:11px;background:rgba(@(statusColorRgb),.15);border:1px solid rgba(@(statusColorRgb),.3);display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 0 16px rgba(@(statusColorRgb),.12)">
            <i class="bi @statusIcon" style="color:@statusColor;font-size:1.1rem"></i>
        </div>
        <div>
            <div style="font-size:.88rem;font-weight:700;color:var(--text);margin-bottom:2px;font-family:var(--font-display)">@statusTitle</div>
            <div style="font-size:.81rem;color:var(--text-muted)">@statusText</div>
        </div>
    </div>

    <div class="ims-card mb-4">
        <div class="ims-card-header">
            <span><i class="bi bi-building me-2" style="color:var(--purple)"></i>Internship Details</span>
            <span class="badge @(internship.Status == IMS.Web.Enums.InternshipStatus.Approved ? "bg-success" :
                                  internship.Status == IMS.Web.Enums.InternshipStatus.Rejected ? "bg-danger" :
                                  "bg-warning text-dark")">
                @internship.Status
            </span>
        </div>
        <div class="ims-card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div style="color:var(--text-muted);font-size:.75rem;margin-bottom:4px;text-transform:uppercase;letter-spacing:.04em">Company</div>
                    <div style="font-weight:600;font-size:.95rem">@internship.CompanyName</div>
                </div>
                <div class="col-md-6">
                    <div style="color:var(--text-muted);font-size:.75rem;margin-bottom:4px;text-transform:uppercase;letter-spacing:.04em">Position</div>
                    <div style="font-size:.95rem">@internship.Position</div>
                </div>
                <div class="col-md-6">
                    <div style="color:var(--text-muted);font-size:.75rem;margin-bottom:4px;text-transform:uppercase;letter-spacing:.04em">Period</div>
                    <div>
                        @if (internship.StartDate.HasValue && internship.EndDate.HasValue)
                        {
                            @internship.StartDate.Value.ToString("dd MMM yyyy")
                            <span style="color:var(--text-muted);margin:0 6px">→</span>
                            @internship.EndDate.Value.ToString("dd MMM yyyy")
                        }
                        else
                        {
                            <span style="color:var(--text-muted)">Not set yet</span>
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <div style="color:var(--text-muted);font-size:.75rem;margin-bottom:4px;text-transform:uppercase;letter-spacing:.04em">Supervisor</div>
                    <div>
                        @if (internship.Supervisor is not null)
                        {
                            <i class="bi bi-person-check me-1" style="color:var(--green)"></i>@internship.Supervisor.FullName
                        }
                        else
                        {
                            <span style="color:var(--text-muted)"><i class="bi bi-person-dash me-1"></i>Not assigned yet</span>
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <div style="color:var(--text-muted);font-size:.75rem;margin-bottom:4px;text-transform:uppercase;letter-spacing:.04em">Applied On</div>
                    <div>@internship.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                </div>
            </div>
        </div>
        @if (internship.Status == IMS.Web.Enums.InternshipStatus.Pending)
        {
            <div style="padding:16px 20px;border-top:1px solid var(--card-border)">
                <form asp-action="WithdrawApplication" method="post"
                      onsubmit="return confirm('Withdraw your application? This cannot be undone.')">
                    <input type="hidden" name="internshipId" value="@internship.Id" />
                    <button class="btn-ims btn-ims-danger"><i class="bi bi-x-circle me-1"></i>Withdraw Application</button>
                </form>
            </div>
        }
        @if (internship.Status == IMS.Web.Enums.InternshipStatus.Rejected)
        {
            <div style="padding:16px 20px;border-top:1px solid var(--card-border)">
                <form asp-action="DismissRejection" method="post"
                      onsubmit="return confirm('Clear rejection so you can apply again?')">
                    <input type="hidden" name="internshipId" value="@internship.Id" />
                    <button class="btn-ims btn-ims-warning"><i class="bi bi-arrow-repeat me-1"></i>Apply Again</button>
                </form>
            </div>
        }
    </div>

    @if (internship.Status == IMS.Web.Enums.InternshipStatus.Approved)
    {
        <div class="d-flex gap-3 flex-wrap">
            <a asp-action="Reports" class="btn-ims btn-ims-primary">
                <i class="bi bi-clipboard-check me-2"></i>View My Tasks
            </a>
            <a asp-action="Evaluations" class="btn-ims btn-ims-warning">
                <i class="bi bi-star-half me-2"></i>View My Evaluations
            </a>
        </div>
    }
}
