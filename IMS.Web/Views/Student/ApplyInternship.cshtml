@model IMS.Web.Models.Internship
@{ ViewData["Title"] = "Apply for Internship"; }

<div style="margin-bottom:20px;display:flex;align-items:center;gap:10px">
    <div style="background:rgba(6,182,212,.1);border:1px solid rgba(6,182,212,.2);border-radius:10px;padding:10px 16px;font-size:.85rem;color:var(--cyan);flex:1">
        <i class="bi bi-megaphone me-2"></i>The university has posted internship opportunities you can apply to.
    </div>
    <a asp-action="Opportunities" class="btn-ims btn-ims-primary" style="white-space:nowrap">
        <i class="bi bi-search me-1"></i>Browse
    </a>
</div>

<div style="max-width:600px">
    <div class="ims-card">
        <div class="ims-card-header">
            <span><i class="bi bi-briefcase me-2" style="color:var(--purple)"></i>Apply for Internship</span>
        </div>
        <div class="ims-card-body">
            <form asp-action="ApplyInternship" method="post">
                <div class="mb-3">
                    <label class="form-label">Company Name</label>
                    <input asp-for="CompanyName" class="form-control" placeholder="e.g. Arab Bank" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Position / Role</label>
                    <input asp-for="Position" class="form-control" placeholder="e.g. Frontend Developer" required />
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label">Start Date</label>
                        <input asp-for="StartDate" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">End Date</label>
                        <input asp-for="EndDate" type="date" class="form-control" required />
                    </div>
                </div>
                <div style="background:rgba(139,92,246,.08);border:1px solid rgba(139,92,246,.2);border-radius:8px;padding:10px 14px;font-size:.82rem;color:var(--text-muted);margin-bottom:20px">
                    <i class="bi bi-info-circle me-1" style="color:var(--purple)"></i>
                    A supervisor will be assigned by the coordinator after your application is reviewed.
                </div>
                <button type="submit" class="btn-ims btn-ims-primary w-100" style="justify-content:center;padding:11px">
                    <i class="bi bi-send me-1"></i>Submit Application
                </button>
            </form>
        </div>
    </div>
</div>
