@model IMS.Web.ViewModels.RegisterViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register – NEXTERN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="/css/theme.css" rel="stylesheet" />
</head>
<body class="auth-page">

<div style="position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:0">
    <div style="position:absolute;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(6,182,212,.1),transparent 70%);top:-150px;right:-150px"></div>
    <div style="position:absolute;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(139,92,246,.1),transparent 70%);bottom:0;left:-100px"></div>
</div>

<div class="auth-card" style="position:relative;z-index:1">

    <div class="text-center mb-4">
        <img src="/images/Nextern_Logo_DarkText_with_Subtitle.png" alt="NEXTERN" style="max-width:200px;width:100%;height:auto;display:block;margin:0 auto 20px;filter:invert(1) hue-rotate(180deg)" />
        <h4 style="font-size:1.15rem;font-weight:800;color:var(--text);margin:0 0 5px">Create account</h4>
        <p style="font-size:.84rem;color:var(--text-muted);margin:0">Join the NEXTERN platform</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger mb-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Html.ValidationSummary(false)
        </div>
    }

    <form asp-action="Register" method="post">
        <div class="mb-3">
            <label class="form-label">Full Name</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person" style="font-size:13px"></i></span>
                <input asp-for="FullName" class="form-control" placeholder="Your full name" />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Email address</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-envelope" style="font-size:13px"></i></span>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Password</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-lock" style="font-size:13px"></i></span>
                <input asp-for="Password" class="form-control" placeholder="••••••••" />
            </div>
        </div>
        <div class="mb-4">
            <label class="form-label">Role</label>
            <select asp-for="Role" class="form-select">
                <option value="0">Student</option>
                <option value="1">Supervisor</option>
                <option value="2">Coordinator</option>
            </select>
        </div>
        <button type="submit" class="btn-ims btn-ims-primary w-100" style="justify-content:center;padding:12px;font-size:.9rem">
            <i class="bi bi-person-check me-1"></i>Create Account
        </button>
    </form>

    <div style="margin-top:22px;padding-top:20px;border-top:1px solid var(--card-border);text-align:center">
        <span style="font-size:.84rem;color:var(--text-muted)">Already have an account?
            <a asp-action="Login" style="background:var(--brand-grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;font-weight:700;text-decoration:none">Sign in</a>
        </span>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
