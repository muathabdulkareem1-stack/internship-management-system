@model IMS.Web.Models.Internship
@{ ViewData["Title"] = "Edit Internship Dates"; }

<div class="row justify-content-center">
    <div class="col-md-5">

        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-action="Internships" class="btn-ims btn-ims-outline" style="padding:7px 12px">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h4 style="font-size:1.1rem;font-weight:700;color:var(--text);margin:0">
                <i class="bi bi-calendar-range me-2" style="color:var(--purple)"></i>Edit Internship Dates
            </h4>
        </div>

        <div class="ims-card mb-3">
            <div class="ims-card-body">
                <div style="font-weight:600;margin-bottom:4px">@Model.Student?.FullName</div>
                <div style="font-size:.83rem;color:var(--text-muted)">@Model.CompanyName — @Model.Position</div>
            </div>
        </div>

        <div class="ims-card">
            <div class="ims-card-body">
                <form asp-action="EditDates" asp-route-id="@Model.Id" method="post">

                    <div class="mb-3">
                        <label class="form-label">Start Date</label>
                        <input name="startDate" type="date" class="form-control"
                               value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label">End Date</label>
                        <input name="endDate" type="date" class="form-control"
                               value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" required />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-ims btn-ims-primary">
                            <i class="bi bi-floppy me-1"></i>Save Dates
                        </button>
                        <a asp-action="Internships" class="btn-ims btn-ims-outline">Cancel</a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>
