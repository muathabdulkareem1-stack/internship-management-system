@{ ViewData["Title"] = "Post Opportunity"; }

<div class="row justify-content-center">
    <div class="col-md-7">

        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-action="Opportunities" class="btn-ims btn-ims-outline" style="padding:7px 12px">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h4 style="font-size:1.1rem;font-weight:700;color:var(--text);margin:0">
                <i class="bi bi-megaphone me-2" style="color:var(--purple)"></i>Post Internship Opportunity
            </h4>
        </div>

        <div class="ims-card">
            <div class="ims-card-body">
                <form asp-action="PostOpportunity" method="post">

                    <div class="mb-3">
                        <label class="form-label">Position Title</label>
                        <input name="Title" class="form-control" placeholder="e.g. Frontend Developer Intern" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Company Name</label>
                        <input name="CompanyName" class="form-control" placeholder="e.g. Saudi Aramco" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Location</label>
                        <input name="Location" class="form-control" placeholder="e.g. Riyadh, Remote" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="Description" class="form-control" rows="4" required
                            placeholder="Describe the role, responsibilities, requirements..."></textarea>
                    </div>

                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label">Start Date</label>
                            <input name="StartDate" type="date" class="form-control" required />
                        </div>
                        <div class="col">
                            <label class="form-label">End Date</label>
                            <input name="EndDate" type="date" class="form-control" required />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col">
                            <label class="form-label">Application Deadline</label>
                            <input name="ApplicationDeadline" type="date" class="form-control" required />
                        </div>
                        <div class="col">
                            <label class="form-label">Max Students</label>
                            <input name="MaxStudents" type="number" min="1" max="100"
                                   class="form-control" value="1" required />
                            <div class="form-text">How many students can be accepted.</div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-ims btn-ims-primary">
                            <i class="bi bi-megaphone me-1"></i>Post Opportunity
                        </button>
                        <a asp-action="Opportunities" class="btn-ims btn-ims-outline">Cancel</a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>
