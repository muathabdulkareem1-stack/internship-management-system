@model IMS.Web.Models.InternshipOpportunity
@{ ViewData["Title"] = "Edit Opportunity"; }

<div class="row justify-content-center">
    <div class="col-md-7">

        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-action="Opportunities" class="btn-ims btn-ims-outline" style="padding:7px 12px">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h4 style="font-size:1.1rem;font-weight:700;color:var(--text);margin:0">
                <i class="bi bi-pencil-square me-2" style="color:var(--purple)"></i>Edit Opportunity
            </h4>
        </div>

        <div class="ims-card">
            <div class="ims-card-body">
                <form asp-action="EditOpportunity" asp-route-id="@Model.Id" method="post">

                    <div class="mb-3">
                        <label class="form-label">Position Title</label>
                        <input name="title" class="form-control" value="@Model.Title" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Company Name</label>
                        <input name="companyName" class="form-control" value="@Model.CompanyName" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Location</label>
                        <input name="location" class="form-control" value="@Model.Location" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="description" class="form-control" rows="4" required>@Model.Description</textarea>
                    </div>

                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label">Start Date</label>
                            <input name="startDate" type="date" class="form-control"
                                   value="@Model.StartDate.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col">
                            <label class="form-label">End Date</label>
                            <input name="endDate" type="date" class="form-control"
                                   value="@Model.EndDate.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col">
                            <label class="form-label">Application Deadline</label>
                            <input name="applicationDeadline" type="date" class="form-control"
                                   value="@Model.ApplicationDeadline.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col">
                            <label class="form-label">Max Students</label>
                            <input name="maxStudents" type="number" min="1" max="100"
                                   class="form-control" value="@Model.MaxStudents" required />
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-ims btn-ims-primary">
                            <i class="bi bi-floppy me-1"></i>Save Changes
                        </button>
                        <a asp-action="Opportunities" class="btn-ims btn-ims-outline">Cancel</a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>
