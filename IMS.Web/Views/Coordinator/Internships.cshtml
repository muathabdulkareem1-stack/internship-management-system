@model List<IMS.Web.Models.Internship>
@{
    ViewData["Title"] = "All Internships";
    var supervisors = ViewBag.Supervisors as List<IMS.Web.Models.User> ?? [];
}

<div class="d-flex flex-wrap gap-2 mb-4 align-items-center justify-content-between">
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Internships" class="btn-ims @(ViewBag.CurrentStatus is null ? "btn-ims-primary" : "btn-ims-outline")" style="font-size:.82rem;padding:6px 12px">Active</a>
        <a asp-action="Internships" asp-route-status="Pending"   class="btn-ims @(ViewBag.CurrentStatus == "Pending"   ? "btn-ims-warning"  : "btn-ims-outline")" style="font-size:.82rem;padding:6px 12px">Pending</a>
        <a asp-action="Internships" asp-route-status="Approved"  class="btn-ims @(ViewBag.CurrentStatus == "Approved"  ? "btn-ims-success"  : "btn-ims-outline")" style="font-size:.82rem;padding:6px 12px">Approved</a>
        <a asp-action="Internships" asp-route-status="Rejected"  class="btn-ims @(ViewBag.CurrentStatus == "Rejected"  ? "btn-ims-danger"   : "btn-ims-outline")" style="font-size:.82rem;padding:6px 12px">Rejected</a>
        <a asp-action="Internships" asp-route-status="Cancelled" class="btn-ims @(ViewBag.CurrentStatus == "Cancelled" ? "btn-ims-outline"  : "btn-ims-outline")" style="font-size:.82rem;padding:6px 12px">Removed</a>
    </div>
    <form asp-action="Internships" method="get" class="d-flex gap-2">
        @if (ViewBag.CurrentStatus is not null)
        {
            <input type="hidden" name="status" value="@ViewBag.CurrentStatus" />
        }
        <input name="search" type="search" class="form-control form-control-sm"
               placeholder="Search student, company…" value="@ViewBag.CurrentSearch" style="width:220px" />
        <button class="btn-ims btn-ims-outline" style="padding:6px 10px"><i class="bi bi-search"></i></button>
    </form>
</div>

@if (!Model.Any())
{
    <div class="ims-card">
        <div class="ims-card-body">
            <div class="empty-state">
                <i class="bi bi-briefcase" style="font-size:2.5rem;color:var(--purple);opacity:.4"></i>
                <div style="margin-top:12px;font-weight:600;color:var(--text)">No internships found</div>
            </div>
        </div>
    </div>
}

<div class="d-flex flex-column gap-3">
@foreach (var i in Model)
{
    <div class="ims-card">
        <div class="ims-card-body">

            <div class="row align-items-start g-3 mb-3">

                <div class="col-md-5">
                    <div style="font-weight:700;font-size:1rem;margin-bottom:4px">@i.Student?.FullName</div>
                    <div style="font-size:.88rem;color:var(--text-muted);margin-bottom:3px">@i.CompanyName — @i.Position</div>
                    <div style="font-size:.83rem;color:var(--text-muted)">@i.StartDate → @i.EndDate</div>
                    @if (i.Opportunity is not null)
                    {
                        <span class="badge" style="background:rgba(6,182,212,.15);color:var(--cyan);border:1px solid rgba(6,182,212,.3);margin-top:6px">
                            <i class="bi bi-megaphone me-1"></i>Via: @i.Opportunity.Title
                        </span>
                    }
                </div>

                <div class="col-md-4">
                    <div style="font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px">Supervisor</div>
                    @if (i.Supervisor is not null)
                    {
                        <span style="font-size:.88rem"><i class="bi bi-person-check me-1" style="color:var(--green)"></i>@i.Supervisor.FullName</span>
                    }
                    else
                    {
                        <span style="font-size:.85rem;color:var(--text-muted)"><i class="bi bi-person-dash me-1"></i>Not assigned</span>
                    }

                    @if (i.Status == IMS.Web.Enums.InternshipStatus.Approved)
                    {
                        <form asp-action="AssignSupervisor" method="post" class="d-flex gap-2 mt-2 flex-wrap">
                            <input type="hidden" name="id" value="@i.Id" />
                            <select name="supervisorId" class="form-select form-select-sm" style="max-width:190px">
                                <option value="">— No supervisor —</option>
                                @foreach (var s in supervisors)
                                {
                                    if (i.SupervisorId == s.Id)
                                    {
                                        <option value="@s.Id" selected="selected">@s.FullName</option>
                                    }
                                    else
                                    {
                                        <option value="@s.Id">@s.FullName</option>
                                    }
                                }
                            </select>
                            <button type="submit" class="btn-ims btn-ims-outline btn-ims-sm">
                                <i class="bi bi-person-check me-1"></i>Assign
                            </button>
                        </form>
                    }

                    @if (i.Status == IMS.Web.Enums.InternshipStatus.Pending)
                    {
                        <form asp-action="ApproveInternship" method="post" class="d-flex flex-column gap-2 mt-2">
                            <input type="hidden" name="id" value="@i.Id" />
                            <select name="supervisorId" class="form-select form-select-sm" style="max-width:200px">
                                <option value="">— Assign supervisor —</option>
                                @foreach (var s in supervisors)
                                {
                                    <option value="@s.Id">@s.FullName</option>
                                }
                            </select>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn-ims btn-ims-success btn-ims-sm">
                                    <i class="bi bi-check-lg me-1"></i>Approve
                                </button>
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@i.Id" />
                                    <button name="status" value="2" class="btn-ims btn-ims-danger btn-ims-sm">
                                        <i class="bi bi-x-lg me-1"></i>Reject
                                    </button>
                                </form>
                            </div>
                        </form>
                    }
                </div>

                <div class="col-md-3 text-md-end">
                    @{
                        var statusBadge = i.Status == IMS.Web.Enums.InternshipStatus.Approved  ? "bg-success"   :
                                          i.Status == IMS.Web.Enums.InternshipStatus.Rejected  ? "bg-danger"    :
                                          i.Status == IMS.Web.Enums.InternshipStatus.Cancelled ? "bg-secondary" : "bg-warning";
                    }
                    <span class="badge @statusBadge">@i.Status</span>
                </div>

            </div>

            <div style="border-top:1px solid var(--card-border);padding-top:16px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">

                <div class="d-flex gap-2 flex-wrap align-items-center">
                    <a asp-action="InternDetail" asp-route-internshipId="@i.Id" class="iab-btn iab-cyan">Reports</a>
                    <button onclick="loadInternAI(@i.Id, '@i.Student?.FullName')" class="iab-btn iab-ai">AI Insight</button>
                    <a asp-action="EditDates" asp-route-id="@i.Id" class="iab-btn iab-ghost">Edit Dates</a>
                </div>

                <div class="d-flex gap-2 flex-wrap align-items-center">
                    @if (i.Status == IMS.Web.Enums.InternshipStatus.Approved)
                    {
                        <form asp-action="RemoveStudent" method="post"
                              onsubmit="return confirm('Remove @i.Student?.FullName from this internship?')">
                            <input type="hidden" name="id" value="@i.Id" />
                            <button type="submit" class="iab-btn iab-amber">Remove</button>
                        </form>
                    }
                    <form asp-action="DeleteInternship" method="post"
                          onsubmit="return confirm('Permanently delete this internship and ALL its data?')">
                        <input type="hidden" name="id" value="@i.Id" />
                        <button type="submit" class="iab-btn iab-red">Delete</button>
                    </form>
                </div>

            </div>

        </div>
    </div>
}
</div>

<div class="modal fade" id="internAiModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-stars me-2" style="color:var(--purple)"></i>AI Insight — <span id="internAiName"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="internAiBody">
                <div style="text-align:center;padding:40px">
                    <div class="spinner-border" style="color:var(--purple)"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
async function loadInternAI(internshipId, studentName) {
    document.getElementById('internAiName').textContent = studentName;
    document.getElementById('internAiBody').innerHTML =
        '<div style="text-align:center;padding:40px"><div class="spinner-border" style="color:var(--purple)"></div><div style="margin-top:12px;color:var(--text-muted);font-size:.85rem">Analyzing ' + studentName + '...</div></div>';
    new bootstrap.Modal(document.getElementById('internAiModal')).show();

    try {
        const res  = await fetch(`/Coordinator/GetInternAIInsight?internshipId=${internshipId}`);
        if (!res.ok) throw new Error(`Server returned ${res.status}`);
        const data = await res.json();

        if (data.error) {
            document.getElementById('internAiBody').innerHTML =
                `<div class="alert alert-warning">${data.error}</div>`; return;
        }

        const riskColor = data.riskLevel === 'high' ? '#ef4444' : data.riskLevel === 'medium' ? '#f59e0b' : '#10b981';
        const riskBg    = data.riskLevel === 'high' ? 'rgba(239,68,68,.1)' : data.riskLevel === 'medium' ? 'rgba(245,158,11,.1)' : 'rgba(16,185,129,.1)';
        const riskIcon  = data.riskLevel === 'high' ? 'bi-exclamation-triangle-fill' : data.riskLevel === 'medium' ? 'bi-exclamation-circle' : 'bi-check-circle-fill';

        const trendIcon  = data.trendDirection === 'up' ? 'bi-graph-up-arrow' : data.trendDirection === 'down' ? 'bi-graph-down-arrow' : 'bi-dash-lg';
        const trendColor = data.trendDirection === 'up' ? 'var(--green)' : data.trendDirection === 'down' ? 'var(--red)' : 'var(--text-muted)';
        const projColor  = data.projectedHoursPercent >= 90 ? 'var(--green)' : data.projectedHoursPercent >= 60 ? 'var(--amber)' : 'var(--red)';
        const rankColor  = data.cohortRank === 1 ? 'var(--amber)' : data.cohortRank <= Math.ceil(data.totalStudents / 3) ? 'var(--green)' : data.cohortRank > Math.floor(data.totalStudents * 2 / 3) ? 'var(--red)' : 'var(--cyan)';

        document.getElementById('internAiBody').innerHTML = `
          <div class="row g-3">

            <div class="col-md-7">
              <div style="background:var(--bg3);border:1px solid var(--card-border);border-radius:var(--radius);padding:18px;height:100%">
                <div style="font-size:.7rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:12px"><i class="bi bi-chat-text me-1"></i>Summary</div>
                <p style="margin-bottom:12px;font-size:.88rem">${data.summary}</p>
                <div style="background:${riskBg};border:1px solid ${riskColor}30;border-radius:8px;padding:8px 12px;margin-bottom:10px;font-size:.83rem">
                  <i class="bi ${riskIcon} me-1" style="color:${riskColor}"></i>
                  <strong style="color:${riskColor}">Risk: ${(data.riskLevel||'').toUpperCase()}</strong>
                  <span style="color:var(--text-muted)"> — ${data.riskReason}</span>
                </div>
                <div style="font-size:.83rem;color:var(--purple-light);background:rgba(139,92,246,.08);border:1px solid rgba(139,92,246,.2);border-radius:8px;padding:8px 12px">
                  <i class="bi bi-lightbulb me-1"></i>${data.recommendation}
                </div>
              </div>
            </div>

            <div class="col-md-5">
              <div style="background:var(--bg3);border:1px solid var(--card-border);border-radius:var(--radius);padding:18px;height:100%">
                <div style="font-size:.7rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:14px"><i class="bi bi-bar-chart me-1"></i>Key Metrics</div>
                <div style="margin-bottom:12px">
                  <div style="display:flex;justify-content:space-between;margin-bottom:5px"><span style="font-size:.78rem;color:var(--text-muted)">Hours Progress</span><span style="font-size:.78rem;font-weight:600">${data.hoursPercent}%</span></div>
                  <div class="progress" style="height:6px"><div class="progress-bar" style="width:${data.hoursPercent}%;background:var(--cyan)"></div></div>
                </div>
                <div style="margin-bottom:12px">
                  <div style="display:flex;justify-content:space-between;margin-bottom:5px"><span style="font-size:.78rem;color:var(--text-muted)">Task Completion</span><span style="font-size:.78rem;font-weight:600">${data.taskCompletionRate}%</span></div>
                  <div class="progress" style="height:6px"><div class="progress-bar" style="width:${data.taskCompletionRate}%;background:var(--green)"></div></div>
                </div>
                ${data.averageSkillRating != null ? `<div style="margin-bottom:10px"><span style="font-size:.78rem;color:var(--text-muted)">Avg Skill</span><div style="font-size:1.4rem;font-weight:700;color:var(--amber)">${data.averageSkillRating?.toFixed(1)} <span style="font-size:.82rem;font-weight:400;color:var(--text-muted)">/ 5</span></div></div>` : ''}
                ${data.topSkill     ? `<div style="font-size:.8rem;margin-bottom:5px"><i class="bi bi-star-fill me-1" style="color:var(--amber)"></i>Top: <strong>${data.topSkill}</strong></div>` : ''}
                ${data.weakestSkill ? `<div style="font-size:.8rem"><i class="bi bi-arrow-up-circle me-1" style="color:var(--red)"></i>Improve: <strong>${data.weakestSkill}</strong></div>` : ''}
              </div>
            </div>

            <div class="col-md-6">
              <div style="background:var(--bg3);border:1px solid rgba(6,182,212,.2);border-radius:var(--radius);padding:18px">
                <div style="font-size:.7rem;font-weight:700;color:var(--cyan);text-transform:uppercase;letter-spacing:.08em;margin-bottom:14px"><i class="bi bi-graph-up me-1"></i>Future Prediction</div>
                <div style="margin-bottom:12px">
                  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
                    <span style="font-size:.78rem;color:var(--text-muted)">Projected Hours Completion</span>
                    <span style="font-size:.82rem;font-weight:700;color:${projColor}">${data.projectedHoursPercent}%</span>
                  </div>
                  <div class="progress" style="height:8px;background:rgba(255,255,255,.05)">
                    <div class="progress-bar" style="width:${data.projectedHoursPercent}%;background:${projColor};opacity:.85"></div>
                  </div>
                  <div style="font-size:.72rem;color:var(--text-dim);margin-top:4px">At current pace by end of internship</div>
                </div>
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;padding:8px 12px;background:rgba(6,182,212,.06);border-radius:8px;border:1px solid rgba(6,182,212,.15)">
                  <i class="bi ${trendIcon}" style="color:${trendColor};font-size:1rem"></i>
                  <span style="font-size:.82rem;color:var(--text-muted)">${data.performanceTrend || 'Trend data unavailable'}</span>
                </div>
                <div style="font-size:.82rem;color:var(--text-muted);line-height:1.5">${data.projectedOutcome}</div>
              </div>
            </div>

            <div class="col-md-6">
              <div style="background:var(--bg3);border:1px solid rgba(139,92,246,.2);border-radius:var(--radius);padding:18px">
                <div style="font-size:.7rem;font-weight:700;color:var(--purple-light);text-transform:uppercase;letter-spacing:.08em;margin-bottom:14px"><i class="bi bi-people me-1"></i>Cohort Comparison</div>
                <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px">
                  <div style="text-align:center;background:rgba(139,92,246,.1);border:1px solid rgba(139,92,246,.25);border-radius:12px;padding:10px 18px;flex-shrink:0">
                    <div style="font-size:1.8rem;font-weight:800;color:${rankColor};line-height:1">${data.cohortRank}</div>
                    <div style="font-size:.65rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em">of ${data.totalStudents}</div>
                  </div>
                  <div>
                    <div style="font-size:.82rem;font-weight:600;color:var(--text);margin-bottom:3px">${data.percentile || ''}</div>
                    <div style="font-size:.78rem;color:var(--text-muted);line-height:1.5">${data.comparisonSummary}</div>
                  </div>
                </div>
                ${data.aboveAverageIn && data.aboveAverageIn.length > 0 ? `
                <div style="margin-bottom:8px">
                  <div style="font-size:.72rem;color:var(--green);font-weight:600;margin-bottom:4px"><i class="bi bi-arrow-up-circle me-1"></i>Above cohort avg</div>
                  <div style="display:flex;flex-wrap:wrap;gap:5px">${data.aboveAverageIn.map(s => `<span style="background:rgba(16,185,129,.1);color:var(--green-light);border:1px solid rgba(16,185,129,.2);border-radius:20px;padding:2px 10px;font-size:.74rem">${s}</span>`).join('')}</div>
                </div>` : ''}
                ${data.belowAverageIn && data.belowAverageIn.length > 0 ? `
                <div>
                  <div style="font-size:.72rem;color:var(--red);font-weight:600;margin-bottom:4px"><i class="bi bi-arrow-down-circle me-1"></i>Below cohort avg</div>
                  <div style="display:flex;flex-wrap:wrap;gap:5px">${data.belowAverageIn.map(s => `<span style="background:rgba(239,68,68,.1);color:var(--red-light);border:1px solid rgba(239,68,68,.2);border-radius:20px;padding:2px 10px;font-size:.74rem">${s}</span>`).join('')}</div>
                </div>` : ''}
              </div>
            </div>

          </div>`;
    } catch(e) {
        document.getElementById('internAiBody').innerHTML =
            `<div class="alert alert-danger"><strong>Error:</strong> ${e.message}</div>`;
    }
}
</script>
